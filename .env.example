# Port the API server listens on
PORT=3001

# Node environment (development | production)
NODE_ENV=development

# Bhashini speech APIs
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Google Gemini API (used for pedagogical explanations)
GEMINI_API_KEY=

# Session signing secret — set this to a long random string
SESSION_SECRET=

# Postgres connection string (used by @workspace/db)
DATABASE_URL=

# Logging verbosity (trace | debug | info | warn | error | fatal)
LOG_LEVEL=info
